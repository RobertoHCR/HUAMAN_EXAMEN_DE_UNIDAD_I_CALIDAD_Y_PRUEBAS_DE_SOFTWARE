  "components": {
    "schemas": {
      "ConfirmationInput": {
        "properties": {
          "payment": {
            "type": "string",
            "enum": [
              "Pendiente",
              "Pagado"
            ],
            "title": "Payment",
            "default": "Pendiente"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConfirmationInput"
      },
      "CourtInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 70,
            "minLength": 3,
            "title": "Name"
          },
          "venue": {
            "type": "string",
            "maxLength": 70,
            "minLength": 3,
            "title": "Venue"
          },
          "sport": {
            "type": "string",
            "enum": [
              "Fútbol",
              "Vóley",
              "Básquet"
            ],
            "title": "Sport"
          },
          "capacity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 2.0,
            "title": "Capacity"
          },
          "hourly_rate": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Hourly Rate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "venue",
          "sport",
          "capacity",
          "hourly_rate"
        ],
        "title": "CourtInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RentalInput": {
        "properties": {
          "court_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Court Id"
          },
          "user_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "User Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Time"
          },
          "duration": {
            "type": "integer",
            "multipleOf": 30.0,
            "maximum": 240.0,
            "minimum": 30.0,
            "title": "Duration"
          },
          "event": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Event"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "court_id",
          "user_id",
          "date",
          "time",
          "duration",
          "event"
        ],
        "title": "RentalInput"
      },
      "ScheduleInput": {
        "properties": {
          "weekday": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Weekday"
          },
          "opens": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Opens"
          },
          "closes": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Closes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "weekday",
          "opens",
          "closes"
        ],
        "title": "ScheduleInput"
      },
      "UserInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "UserInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}